# Copy this file to .env.local for local dev, and add these to Vercel Environment Variables for production.
# These power the contact form (app/api/contact/route.js).

# Resend API key — get it from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email address that receives contact form submissions.
CONTACT_TO=info@authenticblindsandshutters.com

# "From" address shown on the email.
# Must be from a domain you have verified in Resend (resend.com/domains).
# Until your domain is verified you can use: onboarding@resend.dev (only delivers to your Resend-account email).
RESEND_FROM=Authentic Blinds Website <website@authenticblindsandshutters.com>
