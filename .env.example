# Copy this file to .env.local and fill in real values.
# These power the contact form email (app/api/contact/route.js).

# SMTP server used to send contact-form notifications.
# For GoDaddy email, use smtpout.secureserver.net (port 465, secure).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@authenticblindsandshutters.com
SMTP_PASS=your-mailbox-password

# Where contact-form submissions are delivered, and the From address shown.
CONTACT_TO=info@authenticblindsandshutters.com
CONTACT_FROM=info@authenticblindsandshutters.com
